{
  "task_name": "travel_planner",

  "agent": {
    "model_name": "gpt-5-mini",
    "backend": "openai",
    "api_key": "",
    "base_url": "<OPENAI_BASE_URL>"
  },

  "memory": {
    "use_step_memory": false,
    "memory_system_name": "reasoningbank",
    "server_url": "<MARENA_MEMORY_URL>"
  },

  "env": {
    "env_name": "travel_planner",
    "env_server_url": "<MARENA_ENV_URL>",
    "env_config": {
      "judgement_mode": "hint"
    }
  },

  "task_specific": {
    "max_steps": 30
  },

  "output": {
    "output_dir": "results/reasoningbank/travel-reasoningbank-gpt5mini"
  }
}
